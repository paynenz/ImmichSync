<Window x:Class="ImmichSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImmichSync" Icon="Assets/ImmichSync.ico" Width="790" Height="710"
        MinWidth="585" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="#EFF3F8" Foreground="#182B42" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <GeometryGroup x:Key="IconPetals">
            <EllipseGeometry Center="95,60" RadiusX="13" RadiusY="8" Transform="1,0.65,0,1,0,-61.75"/>
            <EllipseGeometry Center="81,55" RadiusX="10" RadiusY="7" Transform="1,0.45,0,1,0,-36.45"/>
        </GeometryGroup>
        <DrawingImage x:Key="HeaderIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H112 V112 H0 Z"/>
                    <DrawingGroup>
                        <DrawingGroup.Transform><RotateTransform Angle="-90" CenterX="56" CenterY="56"/></DrawingGroup.Transform>
                        <GeometryDrawing Brush="#F25470" Geometry="{StaticResource IconPetals}"/>
                    </DrawingGroup>
                    <DrawingGroup>
                        <DrawingGroup.Transform><RotateTransform Angle="-18" CenterX="56" CenterY="56"/></DrawingGroup.Transform>
                        <GeometryDrawing Brush="#FDA44B" Geometry="{StaticResource IconPetals}"/>
                    </DrawingGroup>
                    <DrawingGroup>
                        <DrawingGroup.Transform><RotateTransform Angle="54" CenterX="56" CenterY="56"/></DrawingGroup.Transform>
                        <GeometryDrawing Brush="#4DB989" Geometry="{StaticResource IconPetals}"/>
                    </DrawingGroup>
                    <DrawingGroup>
                        <DrawingGroup.Transform><RotateTransform Angle="126" CenterX="56" CenterY="56"/></DrawingGroup.Transform>
                        <GeometryDrawing Brush="#4191EE" Geometry="{StaticResource IconPetals}"/>
                    </DrawingGroup>
                    <DrawingGroup>
                        <DrawingGroup.Transform><RotateTransform Angle="198" CenterX="56" CenterY="56"/></DrawingGroup.Transform>
                        <GeometryDrawing Brush="#9E6ED8" Geometry="{StaticResource IconPetals}"/>
                    </DrawingGroup>
                    <GeometryDrawing Brush="#1B2D49">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="56,56" RadiusX="15" RadiusY="15"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M56,47 V60 M50.5,54.5 L56,60 61.5,54.5 M50,65 H62">
                        <GeometryDrawing.Pen>
                            <Pen Brush="White" Thickness="2.8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,5"/>
            <Setter Property="MinHeight" Value="33"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="{StaticResource HeaderIcon}" Width="43" Height="43" Margin="0,0,12,0"/>
            <StackPanel>
                <TextBlock Text="ImmichSync" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Scheduled photo downloads from an Immich album" Foreground="#475C72"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#D3DFEC" BorderThickness="1"
                CornerRadius="9" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="39"/>
                    <RowDefinition Height="39"/>
                    <RowDefinition Height="39"/>
                    <RowDefinition Height="39"/>
                    <RowDefinition Height="39"/>
                    <RowDefinition Height="31"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="_Server address" Target="{Binding ElementName=ServerAddress}"/>
                <TextBox x:Name="ServerAddress" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center"
                         TextChanged="ServerAddress_Changed" ToolTip="For example, https://photos.example.com"/>

                <Label Grid.Row="1" Content="API _key" Target="{Binding ElementName=ApiKey}"/>
                <PasswordBox x:Name="ApiKey" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center"/>

                <Label Grid.Row="2" Content="_Album" Target="{Binding ElementName=Albums}"/>
                <ComboBox x:Name="Albums" Grid.Row="2" Grid.Column="1" DisplayMemberPath="DisplayName"
                          VerticalContentAlignment="Center" MinHeight="31" VerticalAlignment="Center"/>
                <Button x:Name="LoadAlbumsButton" Grid.Row="2" Grid.Column="2" Margin="8,0,0,0"
                        VerticalAlignment="Center" Content="_Load albums" Click="LoadAlbums_Click"/>

                <Label Grid.Row="3" Content="Download _folder" Target="{Binding ElementName=DownloadFolder}"/>
                <TextBox x:Name="DownloadFolder" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/>
                <Button Grid.Row="3" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                        Content="_Browse…" Click="Browse_Click"/>

                <Label Grid.Row="4" Content="Check _every" Target="{Binding ElementName=Interval}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBox x:Name="Interval" Width="72" Text="60" MaxLength="5"/>
                    <TextBlock Text="minutes (1–10,080)" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <CheckBox x:Name="LaunchAtSignIn" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                          VerticalAlignment="Center" Content="Start ImmichSync when I sign in to Windows"/>

                <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="SaveButton" Content="_Save settings" Click="Save_Click"/>
                    <Button x:Name="SyncButton" Margin="8,0,0,0" Content="Sync _now" Click="Sync_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#D3DFEC" BorderThickness="1"
                CornerRadius="9" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Activity log" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="ActivityLog" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" Background="#F5F8FC" BorderBrush="#D3DFEC"
                         FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Activity log"/>
            </DockPanel>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,11,0,0">
            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="#475C72" Text="Close or minimize to hide in the tray"/>
            <TextBlock x:Name="ScheduleStatus" Foreground="#475C72" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
